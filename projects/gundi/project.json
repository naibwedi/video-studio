 ],
 "subtitles": {
  "lines": [
   {
    "text": "ጉንዲ ዓይነይ'ዩ ሰራውር ሰዲዱለይ",
    "start": 16.9,
    "end": 23.46
   },
   {
    "text": "ሰሪቡ ኣበሳይ ጋሪዱ ንውነይ",
    "start": 24.62,
    "end": 31.58
   },
   {
    "text": "ከምቲ ክርዳድ ብኣጋ ከይምሖ",
    "start": 31.92,
    "end": 38.0
   },
   {
    "text": "እቲ ሓሳባተይ ኣይነጽሀን ብኣምሆ",
    "start": 39.42,
    "end": 45.54
   },
   {
    "text": "ዘድክመኒ ኃጢኣት ኣብ ደመይ የስርጾ",
    "start": 48.32,
    "end": 53.76
   },
   {
    "text": "ና ኽድመር በደል ስዕረት የናውጾ",
    "start": 55.82,
    "end": 61.12
   },
   {
    "text": "ሓበላ ጉንዲ ዓይነይ ንውሽጢ ሶሊኹ",
    "start": 62.6,
    "end": 68.48
   },
   {
    "text": "ሕዱር ቃንዛይ መዘዝ ዘልዓለም ወሲኹ",
    "start": 70.16,
    "end": 75.64
   },
   {
    "text": "በሰር ካልኦት ይፍትን ክርኢ",
    "start": 77.09,
    "end": 83.66
   },
   {
    "text": "ይህወኽ ይስምብድ ንጥፍኣት የሳሲ",
    "start": 84.56,
    "end": 89.96
   },
   {
    "text": "ከም ትውፊት ክፉኣት ዝቓደረ ዛንታ",
    "start": 91.06,
    "end": 97.18
   },
   {
    "text": "ብሰንኪ ልማደይ ስኢነ መስታ",
    "start": 98.46,
    "end": 104.5
   }
  ],
